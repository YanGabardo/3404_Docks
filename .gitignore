# Docks — .gitignore

# Bancos SQLite gerados localmente
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Pasta padrão criada pelo Flask / Flask-SQLAlchemy
instance/

#  Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Ambientes virtuais
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# Testes / cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# WhatsApp Web.js
.wwebjs_auth/
.wwebjs_cache/
**/.wwebjs_auth/
**/.wwebjs_cache/

# Tuya / TinyTuya
devices.json
snapshot.json
tinytuya.json
tuya-raw.json
**/devices.json
**/snapshot.json
**/tinytuya.json
**/tuya-raw.json

# Variáveis de Ambiente e Credenciais
.env
.env.*
*.env
!.env.example

# Chaves e certificados privados
*.pem
*.key
*.p12
*.pfx

# Arquivos locais de configurações privadas
secrets.json
credentials.json
config.local.json
**/secrets.json
**/credentials.json
**/config.local.json

# Câmera IP
captura.jpg
gravacao_*.avi
*.avi
gravacao_*.mp4
recordings/
gravacoes/

# Uploads e Arquivos Temporários
uploads/
tmp/
temp/
*.tmp
*.temp

# Logs
*.log
logs/

# PID / processos locais
*.pid
*.pid.lock

# Arquivos de cache
.cache/
cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Documentos
~$*.docx
~$*.xlsx
~$*.pptx

# Backups
*.bak
*.backup
*.old
*.orig
